{
	"name": "meeting-composer",
	"version": "2.0.0",
	"description": "Scan meeting minutes and navigate topics across all files from a sidebar topic tree",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc -p tsconfig.v2.json --noEmit",
		"typecheck:all": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@types/react": "^18.2.74",
		"@types/react-dom": "^18.2.24",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"vitest": "^1.6.0"
	},
	"dependencies": {
		"codemirror": "^6.0.1",
		"node": "^18.20.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"recoil": "^0.7.7"
	}
}
